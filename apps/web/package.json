{
  "name": "rentstage-web",
  "version": "0.13.4",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test lib/*.test.ts",
    "test:coverage": "node --experimental-strip-types --test --experimental-test-coverage lib/*.test.ts",
    "test:ci": "npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "firebase": "12.17.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^6.0.0"
  },
  "type": "module"
}
