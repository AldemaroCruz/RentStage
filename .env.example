# RentStage local development only.
# Staging is configured through the GitHub `staging` Environment, Workload
# Identity Federation, Terraform, Cloud Run, Cloud SQL, and Secret Manager.

POSTGRES_DB=rentstage
POSTGRES_USER=rentstage
POSTGRES_PASSWORD=rentstage_local_change_me
POSTGRES_PORT=5433
API_PORT=8080
WEB_PORT=3000
AUTH_EMULATOR_PORT=9099
AUTH_EMULATOR_UI_PORT=4000

FIREBASE_PROJECT_ID=demo-rentstage
FIREBASE_API_KEY=rentstage-local-api-key
FIREBASE_AUTH_DOMAIN=demo-rentstage.firebaseapp.com

SEED_DEMO_DATA=true
LOCAL_AUTH_BOOTSTRAP=true
LOCAL_OWNER_EMAIL=owner@rentstage.local
LOCAL_OWNER_PASSWORD=RentStage123!
LOCAL_OWNER_DISPLAY_NAME=Administrador Demo
SESSION_DURATION=12h
PUBLIC_REQUEST_FINGERPRINT_SALT=rentstage-local-public-catalog

# Leave these empty while using DTE MOCK / TEST locally.
DTE_MH_USER=
DTE_MH_PASSWORD=
DTE_MH_SIGNING_PASSWORD=
